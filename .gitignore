# 실제 견본 데이터는 레포 밖에 두세요. 아래는 안전장치일 뿐입니다.
real/
samples/
견본/
storage/
*.local.*
# 사진 업로드를 손으로 시험하다 남긴 사진이 커밋되지 않게 (data-guard와 같은 기준: synthetic/ · docs/images/ · assets/만 허용)
*.jpg
*.jpeg
*.png
*.heic
*.heif
*.webp
*.bmp
*.tif
*.tiff
# 로거 파일 · 내보내기 결과 · 견본 문서 (data-guard와 같은 기준: synthetic/ 아래만 허용)
*.csv
*.tsv
*.xlsx
*.xlsm
*.xls
*.hwp
*.hwpx
*.zip
*.7z
*.txt
# 스캔 문서 (data-guard: docs/ 아래만 허용)
*.pdf
!docs/**/*.pdf
# 내보낸 CSV/TXT를 엑셀 · 리브레오피스로 열면 옆에 생기는 잠금 파일
~$*
.~lock.*#
# 가스·라돈 로거 원본 (GL240 .gbd 바이너리 등) — 손으로 시험한 파일이 커밋되지 않게
*.gbd
*.dat
!requirements*.txt
!LICENSE.txt
!NOTICE.txt
!**/synthetic/**
!docs/images/**
!assets/**

# Python
__pycache__/
*.py[cod]
.venv/
venv/
# 버전별 가상환경 (.venv312 등) — uv가 아닌 python -m venv로 만들면 안쪽 .gitignore가 없다
.venv*/
venv*/
.python-version
src/
*.egg-info/
.eggs/
.tox/
.nox/
.pytest_cache/
.coverage
.coverage.*
coverage.xml
.hypothesis/
htmlcov/
.mypy_cache/
.ruff_cache/
build/
dist/

# 프론트 빌드 결과 (ktl-field-web에서 복사해 넣음) — 폴더 자리만 남긴다
static/mobile/*
!static/mobile/.gitkeep
static/admin/*
!static/admin/.gitkeep

# Node
node_modules/
.vite/
coverage/

# DB · 로그
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*.db-journal
*.log

# OS · 편집기 · AI 작업 지시서
.DS_Store
Thumbs.db
.idea/
.vscode/
.env
.env.*
!.env.example
*.tmp
*.bak
*.swp
*.orig
*.rej
desktop.ini
GEMINI.md
Gemini.md
지시서-*.md
.claude/
.cursor/
.gemini/
.codex/
.aider*
.windsurf/
# Windows
$RECYCLE.BIN/
*.lnk
# 이 레포를 여러 작업 폴더(git worktree)로 나눠 쓸 때 레포 안에 만든 폴더
.worktrees/
